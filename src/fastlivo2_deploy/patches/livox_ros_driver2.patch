diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7344d08..e63a44a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -221,6 +221,21 @@ else(ROS_EDITION STREQUAL "ROS2")
   # uncomment the following section in order to fill in
   # further dependencies manually.
   # find_package(<dependency> REQUIRED)
+  option(BUILD_LIVOX_DRIVER "Build hardware driver (OFF builds original messages only)" ON)
+  if(NOT BUILD_LIVOX_DRIVER)
+    find_package(ament_cmake REQUIRED)
+    find_package(rosidl_default_generators REQUIRED)
+    find_package(builtin_interfaces REQUIRED)
+    find_package(std_msgs REQUIRED)
+    rosidl_generate_interfaces(livox_interfaces2
+      "msg/CustomPoint.msg" "msg/CustomMsg.msg"
+      DEPENDENCIES builtin_interfaces std_msgs
+      LIBRARY_NAME ${PROJECT_NAME})
+    ament_export_dependencies(rosidl_default_runtime)
+    ament_package()
+    return()
+  endif()
+
   find_package(ament_cmake_auto REQUIRED)
   ament_auto_find_build_dependencies()
   find_package(PCL REQUIRED)
diff --git a/package.xml b/package.xml
new file mode 100644
--- /dev/null
+++ b/package.xml
@@ -0,0 +1,35 @@
