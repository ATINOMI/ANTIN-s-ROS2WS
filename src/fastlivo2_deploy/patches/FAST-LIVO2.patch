+// Full 360-degree geometry in the final state frame; independent of camera visibility.
+void LIVMapper::publish_full_world_scan()
+{
+  pcl::PointCloud<pcl::PointXYZI> cloud;
+  pcl::copyPointCloud(*pcl_w_wait_pub, cloud);
+  sensor_msgs::msg::PointCloud2 message;
+  pcl::toROSMsg(cloud, message);
+  message.header.frame_id = "camera_init";
+  message.header.stamp = rclcpp::Time(static_cast<int64_t>(LidarMeasures.last_lio_update_time * 1e9), RCL_ROS_TIME);
+  pubFullWorldScan->publish(message);
+}
