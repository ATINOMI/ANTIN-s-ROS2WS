+
+TEST(GazeboSnapshot, RejectsNonFiniteAndBlindReturns)
+{
+    Preprocess preprocess;
+    preprocess.lidar_type = GAZEBO_SNAPSHOT;
+    preprocess.blind = 0.3;
+    const float inf = std::numeric_limits<float>::infinity();
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    auto message = cloud({{1, 2, 3, 4}, {inf, 0, 1, 4}, {1, nan, 0, 4},
+                          {0.1, 0.1, 0.1, 4}, {2, 1, -1, inf}});
+    PointCloudXYZI::Ptr output(new PointCloudXYZI);
+    preprocess.process(message, output);
+    ASSERT_EQ(output->size(), 2u);
+    EXPECT_FLOAT_EQ(output->at(0).z, 3.f);
+    EXPECT_FLOAT_EQ(output->at(1).z, -1.f);
+    EXPECT_FLOAT_EQ(output->at(1).intensity, 0.f);
+    for (const auto &point : *output) EXPECT_FLOAT_EQ(point.curvature, 0.f);
+}
