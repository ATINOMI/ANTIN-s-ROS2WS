+  pcl::fromROSMsg(*msg, input);
+  if (point_filter_num < 1) throw std::runtime_error("point_filter_num must be positive");
+  for (size_t i = 0; i < input.size(); i += point_filter_num)
+  {
+    const auto &p = input[i];
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z)) continue;
+    if (p.x*p.x + p.y*p.y + p.z*p.z < blind*blind) continue;
+    PointType out{};
+    out.x = p.x; out.y = p.y; out.z = p.z;
+    out.intensity = std::isfinite(p.intensity) ? p.intensity : 0.0f;
+    out.curvature = 0.0f;  // All points were rendered at the header timestamp.
+    pl_surf.push_back(out);
+  }
+}
