Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
- Class: mini_nav_teleop/Ps5Control
  Name: PS5 手柄控制
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 1
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: rviz_default_plugins/Axes
    Enabled: true
    Length: 0.5
    Name: Axes
    Radius: 0.02
    Reference Frame: camera_init
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 238; 238; 236
    Color Transformer: AxisColor
    Decay Time: 0.0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 159
    Min Color: 0; 0; 0
    Min Intensity: 5
    Name: LiDAR map (rainbow)
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 2.0
    Size (m): 0.015
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fastlivo/map
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 238; 238; 236
    Color Transformer: RGB8
    Decay Time: 0.0
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 159
    Min Color: 0; 0; 0
    Min Intensity: 5
    Name: Camera map (RGB)
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3.0
    Size (m): 0.015
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Transient Local
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /fastlivo/color_map
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: false
    Autocompute Value Bounds:
      Max Value: 15
      Min Value: -5
      Value: false
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 238; 238; 236
    Color Transformer: RGB8
    Decay Time: 0.5
    Enabled: true
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 159
    Min Color: 0; 0; 0
    Min Intensity: 5
    Name: Colored cloud
    Position Transformer: XYZ
    Selectable: false
    Size (Pixels): 3.0
    Size (m): 0.015
    Style: Points
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /cloud_registered
    Use Fixed Frame: true
    Use rainbow: true
    Value: true
  - Alpha: 1.0
    Buffer Length: 1
    Class: rviz_default_plugins/Path
    Color: 25; 255; 255
    Enabled: true
    Head Diameter: 0
    Head Length: 0
    Length: 0.30000001192092896
    Line Style: Billboards
    Line Width: 0.025
    Name: Estimated trajectory
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Color: 25; 255; 255
    Pose Style: None
    Radius: 0.029999999329447746
    Shaft Diameter: 0.4000000059604645
    Shaft Length: 0.4000000059604645
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /path
    Value: true
  - Angle Tolerance: 0.009999999776482582
    Class: rviz_default_plugins/Odometry
    Covariance:
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: true
      Position:
        Alpha: 0.30000001192092896
        Color: 204; 51; 204
        Scale: 1
        Value: true
      Value: false
    Enabled: true
    Keep: 1
    Name: Estimated pose
    Position Tolerance: 0.0010000000474974513
    Shape:
      Alpha: 1
      Axes Length: 0.3
      Axes Radius: 0.025
      Color: 255; 85; 0
      Head Length: 0
      Head Radius: 0
      Shaft Length: 0.800000011920929
      Shaft Radius: 0.5
      Value: Axes
    Topic:
      Depth: 5
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /aft_mapped_to_init
    Value: true
  - Class: rviz_default_plugins/Image
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: Visual image
    Normalize Range: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /rgb_img
    Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: camera_init
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6.0
      Pitch: 0.85
      Yaw: 0.8
      Target Frame: camera_init
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.2
    Saved: []
Window Geometry:
  Width: 1280
  Height: 800
