Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: FAST-LIO2 Map
      Enabled: true
      Topic:
        Value: /ikd_tree
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Transformer: AxisColor
      Axis: Z
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Registered Scan
      Enabled: true
      Topic:
        Value: /cloud_registered
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color Transformer: FlatColor
      Color: 255; 220; 60
      Style: Points
      Size (Pixels): 2
      Decay Time: 0.15
    - Class: rviz_default_plugins/Path
      Name: FAST-LIO2 Trajectory
      Enabled: true
      Topic:
        Value: /path
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 255; 70; 70
      Line Width: 0.04
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Fixed Frame: odom
    Background Color: 25; 29; 35
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Pitch: 0.7
      Yaw: 0.7
      Focal Point:
        X: 2
        Y: 0.5
        Z: 0
Window Geometry:
  Width: 1150
  Height: 820
  X: 490
  Y: 50
