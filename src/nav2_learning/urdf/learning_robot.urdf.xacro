<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="learning_robot">
  <material name="blue"><color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <link name="base_footprint"/>
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry><box size="0.45 0.35 0.20"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><geometry><box size="0.45 0.35 0.20"/></geometry></collision>
    <inertial><mass value="5.0"/><inertia ixx="0.08" ixy="0" ixz="0" iyy="0.11" iyz="0" izz="0.13"/></inertial>
  </link>
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry><material name="black"/></visual>
      <collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.08" length="0.04"/></geometry></collision>
    </link>
    <joint name="${name}_joint" type="continuous"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} -0.08"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:wheel name="left_front_wheel" x="0.15" y="0.19"/>
  <xacro:wheel name="left_rear_wheel" x="-0.15" y="0.19"/>
  <xacro:wheel name="right_front_wheel" x="0.15" y="-0.19"/>
  <xacro:wheel name="right_rear_wheel" x="-0.15" y="-0.19"/>
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.12 0 0.17"/>
  </joint>
  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.045" length="0.05"/></geometry>
      <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
    </visual>
  </link>
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint><left_joint>left_rear_wheel_joint</left_joint><right_joint>right_front_wheel_joint</right_joint><right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>0.38</wheel_separation><wheel_radius>0.08</wheel_radius><topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>
  <gazebo reference="laser_link">
    <sensor name="laser" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <gz_frame_id>laser_link</gz_frame_id>
      <ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range></ray>
    </sensor>
  </gazebo>
</robot>
